+  dxbc::Src count_src(dxbc::Src::R(temp, dxbc::Src::kXXXX));
+  dxbc::Dest address_dest(dxbc::Dest::R(temp, 0b0010));
+  dxbc::Src address_src(dxbc::Src::R(temp, dxbc::Src::kYYYY));
+  a_.OpAnd(count_dest, LoadFlagsSystemConstant(), dxbc::Src::LU(kSysFlag_ROVOcclusionQuery));
+  a_.OpIf(true, count_src);
+  {
+    a_.OpAnd(count_dest, dxbc::Src::R(mask_temp).Select(component), dxbc::Src::LU(15));
+    a_.OpUShR(address_dest, count_src, dxbc::Src::LU(1));
+    a_.OpAnd(address_dest, address_src, dxbc::Src::LU(5));
+    a_.OpIAdd(count_dest, count_src, -address_src);
+    a_.OpUShR(address_dest, count_src, dxbc::Src::LU(2));
+    a_.OpAnd(count_dest, count_src, dxbc::Src::LU(3));
+    a_.OpIAdd(count_dest, count_src, address_src);
+    a_.OpIf(true, count_src);
+    {
