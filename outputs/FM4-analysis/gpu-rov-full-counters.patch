+      in_position_used_ |= 0b0011;
+      a_.OpFToU(dxbc::Dest::R(position, 3), dxbc::Src::V1D(in_reg_ps_position_));
+      a_.OpUMAd(address_dest, dxbc::Src::R(position, dxbc::Src::kYYYY),
+                dxbc::Src::LU(64), dxbc::Src::R(position, dxbc::Src::kXXXX));
+      a_.OpAnd(address_dest, address_src, dxbc::Src::LU(kROVOcclusionBucketCount - 1));
+      a_.OpIShL(address_dest, address_src, dxbc::Src::LU(2));
+      if (counter != ROVOcclusionCounter::kZPass) {
+        a_.OpIAdd(address_dest, address_src,
+                  dxbc::Src::LU(uint32_t(counter) * kROVOcclusionBucketCount * sizeof(uint32_t)));
+      }
+      if (uav_index_occlusion_counter_ == kBindingIndexUnallocated) {
+        uav_index_occlusion_counter_ = uav_count_++;
+      }
+      a_.OpAtomicIAdd(
+          dxbc::Dest::U(uav_index_occlusion_counter_, uint32_t(UAVRegister::kOcclusionCounter)),
+          address_src, 1, count_src);
+      PopSystemTemp();
+    }
+    a_.OpEndIf();
