 Entry::~Entry() = default;
 
+bool Entry::delete_on_close() const {
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  return delete_on_close_;
+}
+
+X_STATUS Entry::SetForDeletion(bool pending) {
+  auto global_lock = global_critical_region_.Acquire();
+  if (pending) {
+    if (!parent_ || is_read_only()) return X_STATUS_ACCESS_DENIED;
+    if ((attributes_ & kFileAttributeDirectory) && !children_.empty()) {
+      return static_cast<X_STATUS>(0xC0000101);  // STATUS_DIRECTORY_NOT_EMPTY
+    }
+  }
+  delete_on_close_ = pending;
+  return X_STATUS_SUCCESS;
+}
+
+void Entry::RetainFile() {
+  auto global_lock = global_critical_region_.Acquire();
+  ++open_file_count_;
+}
+
+void Entry::ReleaseFile() {
+  auto global_lock = global_critical_region_.Acquire();
+  assert_true(open_file_count_ != 0);
+  --open_file_count_;
+  if (!open_file_count_ && delete_on_close_ && parent_ &&
+      (!(attributes_ & kFileAttributeDirectory) || children_.empty())) {
+    // Delete may destroy this Entry. Do not access members afterwards.
+    Delete();
+  }
+}
+
+bool Entry::HasOpenFiles() const {
+  if (open_file_count_) return true;
+  for (const auto& child : children_) {
+    if (child->HasOpenFiles()) return true;
+  }
+  return false;
+}
