+  perf_trace::Increment(awaited ? perf_trace::Count::kOcclusionAwaited
+                                : perf_trace::Count::kOcclusionUnawaited);
+  constexpr uint32_t bytes = kROVOcclusionWords * sizeof(uint32_t);
+  if (!rov_occlusion_initialized_) {
